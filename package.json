{
  "name": "guestbook",
  "private": true,
  "description": "minimalist serverless app",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run build && npm run secrets:scan",
    "secrets:scan": "bash scripts/scan-secrets.sh"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
